# Copy this file to .env and fill in real values
SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database. Local SQLite:
DATABASE_URL=sqlite:///db.sqlite3
# Or Postgres on Render:
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# CORS - wherever the React frontend is served from
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ========================
# AI Provider Configuration
# ========================
# Choose: 'gemini' (free) or 'claude' (paid)
AI_PROVIDER=gemini

# --- Google Gemini (FREE tier - recommended) ---
# Get a free API key at: https://aistudio.google.com/app/apikey
# Free tier: 15 requests/minute, 1000 requests/day, no credit card required
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Anthropic Claude (paid alternative) ---
# Only needed if AI_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
